# OSINT Analyzer - Environment Variables
# Copy to .env.local and fill in what you need. Every API key is optional:
# sources without a key are skipped and shown as "not checked".

# =============================================
# ACCOUNTS (required for login, settings, IP analysis and bulk mode)
# =============================================

# Secret used to encrypt users' saved API keys (AES-256-GCM). At least 32
# characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it makes previously saved keys unreadable (users must re-enter them).
KEY_ENCRYPTION_SECRET=

# SQLite database location (created on first run)
DATABASE_URL=file:./data/osint.db

# ---------------------------------------------
# Sign-in (Auth.js). Accounts can use Google, GitHub and/or email + password.
# ---------------------------------------------

# Signs Auth.js's own cookies (CSRF, OAuth state). Required. Generate one with:
#   npx auth secret      (or the node command above)
AUTH_SECRET=

# The public address of the site. Session cookies are Secure when this is https.
AUTH_URL=https://osint.okoro.me

# Google: https://console.cloud.google.com/apis/credentials  (OAuth client, "Web application")
# Authorised redirect URI: https://osint.okoro.me/api/auth/callback/google
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers  (New OAuth App)
# Authorization callback URL: https://osint.okoro.me/api/auth/callback/github
# Leave empty to hide the "Continue with GitHub" button.
GITHUB_ID=
GITHUB_SECRET=

# ---------------------------------------------
# Email (confirmation links for email + password signups and email changes)
# ---------------------------------------------
# Sent through Resend (https://resend.com). If RESEND_API_KEY is empty, no
# email is sent: the link is written to the server log ([verification] ...)
# and the form tells the user so.
RESEND_API_KEY=

# Sender and reply-to. The From domain must be verified in Resend (SPF, DKIM,
# DMARC). These are the defaults used when the variables are unset.
MAIL_FROM="OSINT Analyzer <osint@mail.protechnetworks.org>"
MAIL_REPLY_TO=support@protechnetworks.org

# Base for links in emails. Never taken from the request's Host header.
# Production: https://osint.okoro.me   Development: http://localhost:3000
MAIL_LINK_BASE=https://osint.okoro.me

# =============================================
# SERVER FALLBACK KEYS
# Users can save their own keys in Settings for the services marked (per-user).
# Lookups use the user's key first, then these, otherwise skip the source.
# Bulk mode only ever uses the user's own keys.
# =============================================

# (per-user) VirusTotal - https://www.virustotal.com/gui/join-us
# Free: 500 requests/day, 4/min, non-commercial
VIRUSTOTAL_API_KEY=

# (per-user) AbuseIPDB - https://www.abuseipdb.com/register
# Free: 1,000 checks/day
ABUSEIPDB_API_KEY=

# (per-user) GreyNoise Community - https://viz.greynoise.io/signup
# Free: 50 lookups/week; API keys require a business email address
GREYNOISE_API_KEY=

# (per-user) AlienVault OTX - https://otx.alienvault.com/#signup
OTX_API_KEY=

# (per-user) abuse.ch Auth-Key for URLhaus + ThreatFox - https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# (per-user) Spamhaus DQS - https://portal.spamhaus.com/auth/account-setup?ps=free_dqs_product
# Free for non-commercial use, up to 100,000 queries/day
SPAMHAUS_DQS_KEY=

# (per-user) IPQualityScore - https://www.ipqualityscore.com/create-account
# Free: 1,000 lookups/month, max 35/day (email and phone checks)
IPQUALITYSCORE_API_KEY=

# Google Safe Browsing - https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# URLScan.io (optional) - https://urlscan.io/about-api/
URLSCAN_API_KEY=

# EmailRep.io - https://emailrep.io/key
EMAILREP_API_KEY=

# (per-user) Hunter.io - https://hunter.io/users/sign_up
# Free: 50 credits/month; a verification costs 0.5 (about 100 checks)
HUNTER_API_KEY=

# (per-user) Have I Been Pwned - https://haveibeenpwned.com/Subscription
# Paid only, from about 4.39 USD/month (10 lookups/minute)
HIBP_API_KEY=

# NumVerify - https://numverify.com/product
NUMVERIFY_API_KEY=

# Etherscan - https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Chainalysis sanctions screening
CHAINALYSIS_API_KEY=

# =============================================
# BLOCKLISTS & LOCAL DATA (optional)
# =============================================

# DNS server(s) for DNSBL lookups, comma separated. Defaults to the system
# resolver. Avoid public resolvers (8.8.8.8, 1.1.1.1, 9.9.9.9): Spamhaus,
# URIBL and SURBL refuse them (shown as "refused", never as "listed").
# DNSBL_RESOLVERS=

# Where the daily blocklist feeds (Tor, Feodo, blocklist.de, CINS, FireHOL) are cached
# FEEDS_DIR=./data/feeds

# IP2Proxy LITE database (free, https://lite.ip2location.com). Put an
# IP2PROXY-LITE-PX*.BIN file in ./data/ or point to it here.
# IP2PROXY_DB_PATH=./data/IP2PROXY-LITE-PX12.BIN
